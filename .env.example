# Supabase (optional: the workspace runs locally without it, using browser storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic (optional: without a key the chat route streams built-in demo artifacts)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Set to "true" to redirect signed-out visitors to /login
REQUIRE_AUTH=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000
